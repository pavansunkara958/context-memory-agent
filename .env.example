# Copy to .env. Never commit .env.
#
# The DEFAULT configuration needs no key at all: embeddings, reranking,
# retrieval, memory and the whole evaluation suite run locally.

PROVIDER=offline

# --- PROVIDER=openai --------------------------------------------------------
# OPENAI_API_KEY=sk-...
# MODEL_GENERATE=gpt-5-mini

# --- PROVIDER=gateway : any OpenAI-compatible endpoint ----------------------
# GATEWAY_BASE_URL=https://api.groq.com/openai/v1
# GATEWAY_AUTH_MODE=bearer
# GATEWAY_KEY=gsk_...
# GATEWAY_MODEL=llama-3.3-70b-versatile

# --- Local models -----------------------------------------------------------
EMBED_BACKEND=auto
USE_RERANKER=1

# --- Retrieval and context budgets -----------------------------------------
CHUNK_TOKENS=110
CHUNK_OVERLAP=25
RETRIEVE_K=20
RERANK_K=6
SIM_FLOOR=0.25
SPARSE_FLOOR_RATIO=0.35
DEDUP_THRESHOLD=0.92
CONTEXT_BUDGET_TOKENS=2000
WORKING_MEMORY_TOKENS=800
SESSION_COMPACT_AFTER=8

DATA_DIR=data
